# Everything here is OPTIONAL. With no settings the site works with username + password accounts.

# Recommended: any long random string (so players stay logged in after a restart).
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: keeps cards across redeploys (Supabase / Neon / Render Postgres connection string)
DATABASE_URL=

# Optional: "Login with Discord" (all three are needed together)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Public URL of your site, no trailing slash. Redirect URI to add in Discord: BASE_URL + /auth/callback
BASE_URL=

PORT=3000
